<div class="page-hero">
  <div class="page-width">
    <div class="page-hero__card" data-reveal>
      <div class="doodle">{% render 'illustration', name: 'paws' %}</div>
      <h1>{{ blog.title }}</h1>
      <div class="rte"><p>{{ section.settings.text }}</p></div>
    </div>
  </div>
</div>

<div class="page-width">
  {%- paginate blog.articles by 9 -%}
    <ul class="article-list" role="list">
      {%- for article in blog.articles -%}
        <li class="article-card" data-reveal style="--reveal-i: {{ forloop.index0 | modulo: 3 }};">
          <div class="article-card__media">
            {%- if article.image -%}
              {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.image.alt, widths: '400, 600, 800', sizes: '(min-width: 990px) 30vw, 90vw' }}
            {%- else -%}
              {% render 'placeholder' %}
            {%- endif -%}
          </div>
          <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %-d, %Y' }}</time>
        </li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Previous page">&larr;</a>{%- endif -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Next page">&rarr;</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog posts",
  "class": "section-main-blog",
  "settings": [
    { "type": "text", "id": "text", "label": "Intro", "default": "Tips, stories and the occasional very good boy." }
  ]
}
{% endschema %}
