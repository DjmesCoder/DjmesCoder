<section class="section" aria-labelledby="FeaturedTitle-{{ section.id }}">
  <div class="page-width">
    <div class="featured__head" data-reveal>
      <div class="section-heading" style="margin-bottom: 0;">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 id="FeaturedTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="link-arrow" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
          {{ section.settings.link_label }}
          {% render 'icon', name: 'arrow' %}
        </a>
      {%- endif -%}
    </div>

    <ul class="product-grid featured__grid" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          {% render 'product-card',
            product: block.settings.product,
            index: forloop.index0,
            note: block.settings.note,
            image_fit: section.settings.image_fit
          %}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "class": "section-featured-products",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Staff picks" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The stuff our own mutts vote for" },
    { "type": "text", "id": "text", "label": "Text", "default": "Tried, tested, chewed on (a little). These are the ones we'd buy again." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See everything" },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Product photo fit",
      "options": [
        { "value": "contain", "label": "Show whole product on warm tile" },
        { "value": "cover", "label": "Fill the tile" }
      ],
      "default": "contain"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "note", "label": "Handwritten sticky note (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured products",
      "blocks": [
        { "type": "product", "settings": { "note": "Wear your faith on your fur" } },
        { "type": "product", "settings": { "note": "Lights up night walks" } },
        { "type": "product", "settings": { "note": "Slows down the gulpers" } }
      ]
    }
  ]
}
{% endschema %}
