<article class="page-width page-width--narrow" style="padding-top: clamp(2rem, 5vw, 3.5rem);">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol role="list">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li><a href="{{ blog.url }}">{{ blog.title }}</a></li>
      <li aria-current="page">{{ article.title }}</li>
    </ol>
  </nav>
  <h1 data-reveal>{{ article.title }}</h1>
  <p class="eyebrow">
    <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %-d, %Y' }}</time>
  </p>
  {%- if article.image -%}
    <div class="media" style="aspect-ratio: 16 / 9; border-radius: var(--radius-xl); margin-bottom: 2rem;">
      {{ article.image | image_url: width: 1600 | image_tag: alt: article.image.alt, widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 820px, 94vw' }}
    </div>
  {%- endif -%}
  <div class="content-card rte">{{ article.content }}</div>
</article>

{% schema %}
{
  "name": "Blog post",
  "class": "section-main-article",
  "settings": []
}
{% endschema %}
