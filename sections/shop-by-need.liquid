<section class="section" aria-labelledby="NeedTitle-{{ section.id }}">
  <div class="page-width">
    <div class="needs">
      <div class="page-width">
        <div class="needs__head" data-reveal>
          <div>
            {%- if section.settings.eyebrow != blank -%}
              <p class="eyebrow">{{ section.settings.eyebrow }}</p>
            {%- endif -%}
            <h2 id="NeedTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
          </div>
          {%- if section.settings.note != blank -%}
            <p class="hand-note">{{ section.settings.note }}</p>
          {%- endif -%}
        </div>

        <ul class="needs__grid" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <a
                class="need-tile"
                href="{{ block.settings.collection.url | default: routes.collections_url }}"
                data-reveal
                style="--reveal-i: {{ forloop.index0 }};"
              >
                <span class="need-tile__icon">{% render 'icon', name: block.settings.icon %}</span>
                <span>{{ block.settings.title }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by need",
  "class": "section-shop-by-need",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Shop by need" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's on the list?" },
    { "type": "text", "id": "note", "label": "Handwritten note", "default": "(treats not included. we tried.)" }
  ],
  "blocks": [
    {
      "type": "need",
      "name": "Need tile",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Feeding" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shirt", "label": "Shirt" },
            { "value": "bowl", "label": "Bowl" },
            { "value": "bed", "label": "Bed" },
            { "value": "leash", "label": "Leash & bags" },
            { "value": "brush", "label": "Brush" },
            { "value": "bone", "label": "Bone" },
            { "value": "heart", "label": "Heart" },
            { "value": "paw", "label": "Paw" },
            { "value": "dog", "label": "Dog" },
            { "value": "cat", "label": "Cat" }
          ],
          "default": "bowl"
        },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by need",
      "blocks": [
        { "type": "need", "settings": { "title": "Dog Apparel", "icon": "shirt" } },
        { "type": "need", "settings": { "title": "Feeding", "icon": "bowl" } },
        { "type": "need", "settings": { "title": "Beds & Comfort", "icon": "bed" } },
        { "type": "need", "settings": { "title": "Walks & Potty", "icon": "leash" } },
        { "type": "need", "settings": { "title": "Cleaning & Grooming", "icon": "brush" } }
      ]
    }
  ]
}
{% endschema %}
