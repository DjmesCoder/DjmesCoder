<section class="section" aria-labelledby="NewsletterTitle-{{ section.id }}">
  <div class="page-width">
    <div class="newsletter" data-reveal>
      <div class="doodle doodle--a">{% render 'illustration', name: 'paws' %}</div>
      <div class="doodle doodle--b">{% render 'illustration', name: 'heart' %}</div>

      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="hand-note" style="color: var(--color-sand);">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 id="NewsletterTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      <div class="newsletter__form">
        {%- assign form_id = 'NewsletterForm-' | append: section.id -%}
        {%- form 'customer', id: form_id -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success" role="status">
              {% render 'icon', name: 'check' %}
              <span>{{ section.settings.success }}</span>
            </p>
          {%- elsif form.errors -%}
            <div class="form-message form-message--error" role="alert" id="NewsletterError-{{ section.id }}">
              {% render 'icon', name: 'alert' %}
              <span>
                {%- if form.errors contains 'email' -%}
                  That email doesn't look quite right. Mind checking it?
                {%- else -%}
                  {{ form.errors | default_errors }}
                {%- endif -%}
              </span>
            </div>
          {%- endif -%}

          <label for="NewsletterEmail-{{ section.id }}">Your email</label>
          <div class="newsletter__row">
            <input
              class="input"
              id="NewsletterEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              placeholder="you@example.com"
              required
              {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterError-{{ section.id }}"{% endif %}
            >
            <button class="btn" type="submit">{{ section.settings.button_label }}</button>
          </div>
          {%- if section.settings.fine_print != blank -%}
            <p class="newsletter__fine">{{ section.settings.fine_print }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Handwritten note", "default": "psst, over here" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the pack" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "New arrivals, pet-tested tips and the occasional photo of our office dogs. About twice a month. Never spammy."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Count me in" },
    { "type": "text", "id": "success", "label": "Success message", "default": "You're in! Welcome to the pack. Watch your inbox for a hello." },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Unsubscribe anytime with one click. We won't take it personally." }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
