{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured = current_variant.featured_media | default: product.featured_media
  assign fit = section.settings.image_fit
  assign form_id = 'ProductForm-' | append: section.id

  assign has_size_option = false
  for option in product.options
    assign o = option | downcase
    if o contains 'size'
      assign has_size_option = true
    endif
  endfor
-%}

<div class="page-width" data-product>
  <nav class="breadcrumbs" aria-label="Breadcrumb" style="padding-top: 1.5rem;">
    <ol role="list">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      {%- if collection -%}
        <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
      {%- else -%}
        <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
      {%- endif -%}
      <li aria-current="page">{{ product.title }}</li>
    </ol>
  </nav>

  <div class="product">
    {%- comment -%} Media {%- endcomment -%}
    <div class="product__media" data-reveal>
      <div class="product__main-media{% if fit == 'cover' %} product__main-media--cover{% endif %}">
        {%- if featured -%}
          {%- assign featured_img = featured.preview_image | default: featured -%}
          <img
            src="{{ featured_img | image_url: width: 1200 }}"
            srcset="
              {{ featured_img | image_url: width: 480 }} 480w,
              {{ featured_img | image_url: width: 720 }} 720w,
              {{ featured_img | image_url: width: 960 }} 960w,
              {{ featured_img | image_url: width: 1200 }} 1200w,
              {{ featured_img | image_url: width: 1600 }} 1600w
            "
            sizes="(min-width: 900px) 55vw, 94vw"
            width="{{ featured_img.width }}"
            height="{{ featured_img.height }}"
            alt="{{ featured_img.alt | default: product.title | escape }}"
            fetchpriority="high"
            data-main-image
            data-media-id="{{ featured.id }}"
          >
        {%- else -%}
          {% render 'placeholder', label: 'Product photo' %}
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <ul class="product__thumbs" role="list" aria-label="Product photos">
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' or media.preview_image -%}
              {%- assign img = media.preview_image | default: media -%}
              <li>
                <button
                  type="button"
                  class="product__thumb"
                  data-thumb
                  data-media-id="{{ media.id }}"
                  data-src="{{ img | image_url: width: 1200 }}"
                  data-srcset="{{ img | image_url: width: 720 }} 720w, {{ img | image_url: width: 1200 }} 1200w, {{ img | image_url: width: 1600 }} 1600w"
                  data-alt="{{ img.alt | default: product.title | escape }}"
                  aria-label="Show photo {{ forloop.index }} of {{ product.media.size }}"
                  aria-current="{% if media.id == featured.id %}true{% else %}false{% endif %}"
                >
                  {{ img | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', widths: '120, 200', sizes: '100px' }}
                </button>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- comment -%} Info {%- endcomment -%}
    <div class="product__info">
      <script type="application/json" data-product-json>{{ product | json }}</script>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.show_vendor and product.vendor != blank -%}
                <p class="eyebrow product__vendor">{{ product.vendor }}</p>
              {%- endif -%}
              <h1 class="product__title">{{ product.title }}</h1>
            </div>

          {%- when 'price' -%}
            <div class="product__price" {{ block.shopify_attributes }}>
              {% render 'price', product: product, variant: current_variant, data_price: true %}
            </div>

          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <p class="hand-note" style="margin-bottom: 1.25rem;" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {%- endif -%}

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  {%- liquid
                    assign option_name = option.name | downcase
                    assign is_color = false
                    if option_name == 'color' or option_name == 'colour'
                      assign is_color = true
                    endif
                    assign option_index = forloop.index0
                  -%}
                  <fieldset class="product-form__option" data-option-index="{{ option_index }}" form="{{ form_id }}">
                    <legend>
                      {{ option.name }}:
                      <span data-selected-value>{{ option.selected_value }}</span>
                    </legend>
                    <div class="option-values">
                      {%- for value in option.values -%}
                        {%- assign input_id = section.id | append: '-' | append: option_index | append: '-' | append: forloop.index0 -%}
                        <div class="{% if is_color %}swatch{% else %}pill{% endif %}">
                          <input
                            type="radio"
                            id="Option-{{ input_id }}"
                            name="Option-{{ section.id }}-{{ option_index }}"
                            value="{{ value | escape }}"
                            {% if option.selected_value == value %}checked{% endif %}
                          >
                          <label for="Option-{{ input_id }}"{% if is_color %} title="{{ value | escape }}"{% endif %}>
                            {%- if is_color -%}
                              <span style="--swatch: {% render 'swatch-color', value: value %};"></span>
                              <span class="visually-hidden">{{ value }}</span>
                            {%- else -%}
                              {{ value }}
                            {%- endif -%}
                          </label>
                        </div>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}

          {%- when 'size_guide' -%}
            {%- if has_size_option or block.settings.always_show -%}
              <details class="size-guide" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
                <summary>
                  {% render 'icon', name: 'ruler' %}
                  {{ block.settings.heading }}
                  {% render 'icon', name: 'chevron' %}
                </summary>
                <div class="size-guide__body">
                  {%- if product.metafields.custom.size_guide != blank -%}
                    <div class="rte">{{ product.metafields.custom.size_guide | metafield_tag }}</div>
                  {%- elsif block.settings.page != blank -%}
                    <div class="rte">{{ block.settings.page.content }}</div>
                  {%- else -%}
                    {%- if block.settings.intro != blank -%}
                      <div class="rte">{{ block.settings.intro }}</div>
                    {%- endif -%}
                    <div class="size-table-wrap">
                      <table class="size-table">
                        <caption class="visually-hidden">Dog apparel sizes</caption>
                        <thead>
                          <tr>
                            <th scope="col">Size</th>
                            <th scope="col">Chest</th>
                            <th scope="col">Back length</th>
                            <th scope="col">Weight</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr><th scope="row">XS</th><td>12–14 in</td><td>8 in</td><td>3–6 lb</td></tr>
                          <tr><th scope="row">S</th><td>14–17 in</td><td>10 in</td><td>6–12 lb</td></tr>
                          <tr><th scope="row">M</th><td>17–21 in</td><td>13 in</td><td>12–25 lb</td></tr>
                          <tr><th scope="row">L</th><td>21–25 in</td><td>16 in</td><td>25–45 lb</td></tr>
                          <tr><th scope="row">XL</th><td>25–29 in</td><td>20 in</td><td>45–70 lb</td></tr>
                          <tr><th scope="row">XXL</th><td>29–33 in</td><td>24 in</td><td>70–90 lb</td></tr>
                        </tbody>
                      </table>
                    </div>
                    {%- if block.settings.tip != blank -%}
                      <p>{{ block.settings.tip }}</p>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </details>
            {%- endif -%}

          {%- when 'buy_buttons' -%}
            <div {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'product-form', novalidate: 'novalidate', data-product-form: 'true' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
                <div class="product-form__buy">
                  <div class="quantity">
                    <button type="button" data-qty="-1" aria-label="Decrease quantity">{% render 'icon', name: 'minus' %}</button>
                    <label class="visually-hidden" for="Quantity-{{ section.id }}">Quantity</label>
                    <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
                    <button type="button" data-qty="1" aria-label="Increase quantity">{% render 'icon', name: 'plus' %}</button>
                  </div>
                  <button
                    type="submit"
                    name="add"
                    class="btn btn--accent"
                    data-add-button
                    {% unless current_variant.available %}disabled{% endunless %}
                  >
                    <span data-add-text>
                      {%- if current_variant.available -%}Add to cart{%- else -%}Sold out for now{%- endif -%}
                    </span>
                  </button>
                </div>

                <div class="form-message form-message--error product-form__error" role="alert" data-form-error hidden>
                  {% render 'icon', name: 'alert' %}
                  <span data-error-text></span>
                </div>

                {%- if block.settings.shipping_note != blank -%}
                  <p class="ship-note">
                    {% render 'icon', name: 'truck' %}
                    <span>
                      {{ block.settings.shipping_note }}
                      {%- if block.settings.shipping_subnote != blank -%}
                        <small>{{ block.settings.shipping_subnote }}</small>
                      {%- endif -%}
                    </span>
                  </p>
                {%- endif -%}

                {%- if block.settings.show_dynamic_checkout -%}
                  <div style="margin-top: 0.9rem;">{{ form | payment_button }}</div>
                {%- endif -%}
              {%- endform -%}
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="product__description rte" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>
            {%- endif -%}

          {%- when 'perks' -%}
            <ul class="product__perks" role="list" {{ block.shopify_attributes }}>
              {%- if block.settings.perk_1 != blank -%}<li>{% render 'icon', name: 'return' %}{{ block.settings.perk_1 }}</li>{%- endif -%}
              {%- if block.settings.perk_2 != blank -%}<li>{% render 'icon', name: 'mail-heart' %}{{ block.settings.perk_2 }}</li>{%- endif -%}
              {%- if block.settings.perk_3 != blank -%}<li>{% render 'icon', name: 'paw' %}{{ block.settings.perk_3 }}</li>{%- endif -%}
            </ul>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%} Structured data for search engines {%- endcomment -%}
<script type="application/ld+json">{{ product | structured_data }}</script>

{% schema %}
{
  "name": "Product information",
  "class": "section-main-product",
  "settings": [
    {
      "type": "select",
      "id": "image_fit",
      "label": "Product photo fit",
      "options": [
        { "value": "contain", "label": "Show whole product on warm tile" },
        { "value": "cover", "label": "Fill the frame" }
      ],
      "default": "contain"
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [{ "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false }]
    },
    { "type": "price", "name": "Price", "limit": 1, "settings": [] },
    {
      "type": "text",
      "name": "Handwritten note",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Mutt-tested, owner-approved." }]
    },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1, "settings": [] },
    {
      "type": "size_guide",
      "name": "Size guide",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Shows automatically on products with a Size option. To use a custom guide for one product, add a rich text metafield: custom.size_guide." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Size guide: find the right fit" },
        { "type": "checkbox", "id": "always_show", "label": "Show on every product", "default": false },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false },
        { "type": "page", "id": "page", "label": "Use a page's content instead of the table" },
        {
          "type": "richtext",
          "id": "intro",
          "label": "Intro",
          "default": "<p>Measure around the widest part of your pet's chest, just behind the front legs. Between two sizes? Go up. Nobody likes a tight shirt.</p>"
        },
        { "type": "text", "id": "tip", "label": "Tip below table", "default": "Still unsure? Email us your pet's measurements and breed (or best guess). We'll help you pick." }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "shipping_note", "label": "Shipping note", "default": "Free shipping on every order" },
        { "type": "text", "id": "shipping_subnote", "label": "Shipping subnote", "default": "No minimum. Ships in 1–2 business days." },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show express checkout buttons", "default": false }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1, "settings": [] },
    {
      "type": "perks",
      "name": "Perks list",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "perk_1", "label": "Perk 1", "default": "30-day returns on unopened items" },
        { "type": "text", "id": "perk_2", "label": "Perk 2", "default": "Real people answering your emails" },
        { "type": "text", "id": "perk_3", "label": "Perk 3", "default": "Made for mutts of every shape and size" }
      ]
    }
  ]
}
{% endschema %}
