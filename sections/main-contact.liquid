<div class="page-width" style="padding-top: clamp(2rem, 5vw, 3.5rem);">
  <div class="contact-grid">
    <div class="contact-grid__aside" data-reveal>
      <p class="eyebrow">{% render 'icon', name: 'mail-heart' %}{{ section.settings.eyebrow }}</p>
      <h1>{{ page.title }}</h1>
      {%- if page.content != blank -%}
        <div class="rte">{{ page.content }}</div>
      {%- else -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.email != blank -%}
        <a class="footer__email" style="color: var(--color-forest-deep);" href="mailto:{{ section.settings.email }}">
          {% render 'icon', name: 'mail' %}{{ section.settings.email }}
        </a>
      {%- endif -%}
      <p class="hand-note">{{ section.settings.note }}</p>
    </div>

    <div class="content-card" data-reveal style="--reveal-i: 1;">
      {%- form 'contact', id: 'ContactForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status">
            {% render 'icon', name: 'check' %}
            <span>Got it! A real human will reply within one business day. Usually sooner.</span>
          </p>
        {%- elsif form.errors -%}
          <div class="form-message form-message--error" role="alert" tabindex="-1" id="ContactErrors">
            {% render 'icon', name: 'alert' %}
            <div>
              <strong>Almost there. Please fix:</strong>
              <ul>
                {%- for field in form.errors -%}
                  <li><a href="#Contact-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          </div>
        {%- endif -%}

        <div class="field-row">
          <div class="field">
            <label for="Contact-name">Your name</label>
            <input id="Contact-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name | default: customer.name }}">
          </div>
          <div class="field">
            <label for="Contact-email">Email <span aria-hidden="true">*</span></label>
            <input
              id="Contact-email"
              type="email"
              name="contact[email]"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              required
              value="{{ form.email | default: customer.email }}"
              {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="ContactErrors"{% endif %}
            >
          </div>
        </div>
        <div class="field">
          <label for="Contact-order">Order number (if it's about an order)</label>
          <input id="Contact-order" type="text" name="contact[Order number]" value="{{ form['order number'] }}">
        </div>
        <div class="field">
          <label for="Contact-body">What's up? <span aria-hidden="true">*</span></label>
          <textarea id="Contact-body" name="contact[body]" required{% if form.errors contains 'body' %} aria-invalid="true" aria-describedby="ContactErrors"{% endif %}>{{ form.body }}</textarea>
          <p class="field__help">Pet photos welcome. Encouraged, even.</p>
        </div>
        <button type="submit" class="btn">Send message {% render 'icon', name: 'arrow' %}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact",
  "class": "section-main-contact",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Real people, real replies" },
    { "type": "textarea", "id": "text", "label": "Text (if page is empty)", "default": "Sizing question? Order hiccup? Just want to tell us about your dog? Send a note. One of us will write back, usually within a day." },
    { "type": "text", "id": "email", "label": "Support email", "default": "support@muttmore.com" },
    { "type": "text", "id": "note", "label": "Handwritten note", "default": "We read every single one." }
  ]
}
{% endschema %}
