<div class="page-hero">
  <div class="page-width">
    <div class="page-hero__card" data-reveal>
      <div class="doodle">{% render 'illustration', name: 'paws' %}</div>
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<div class="rte"><p>{{ section.settings.text }}</p></div>{%- endif -%}
    </div>
  </div>
</div>

<div class="page-width">
  <ul class="product-grid collection-list" role="list">
    {%- for collection in collections -%}
      <li data-reveal style="--reveal-i: {{ forloop.index0 | modulo: 3 }};">
        <a class="collection-tile" href="{{ collection.url }}">
          <div class="collection-tile__media">
            {%- assign image = collection.featured_image | default: collection.products.first.featured_media -%}
            {%- if image -%}
              {{ image | image_url: width: 900 | image_tag: loading: 'lazy', alt: '', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 90vw' }}
            {%- else -%}
              {% render 'placeholder', label: collection.title %}
            {%- endif -%}
          </div>
          <h2>{{ collection.title }} {% render 'icon', name: 'arrow' %}</h2>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Collections list",
  "class": "section-main-list-collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the aisles" },
    { "type": "text", "id": "text", "label": "Text", "default": "Grab a basket. Take your time. Sniffing encouraged." }
  ]
}
{% endschema %}
