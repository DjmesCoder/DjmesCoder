<div class="page-width" style="padding-top: clamp(2rem, 5vw, 3.5rem);">
  <h1 data-reveal>{{ section.settings.heading }}</h1>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="CartForm" novalidate>
      <div class="cart">
        <div>
          <ul class="cart__items" role="list">
            {%- for item in cart.items -%}
              <li class="cart-item" data-reveal style="--reveal-i: {{ forloop.index0 | at_most: 4 }};">
                <a class="cart-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 260 | image_tag: loading: 'lazy', alt: '', widths: '130, 260', sizes: '110px' }}
                  {%- else -%}
                    {% render 'placeholder' %}
                  {%- endif -%}
                </a>
                <div>
                  <h2><a href="{{ item.url }}">{{ item.product.title }}</a></h2>
                  {%- unless item.product.has_only_default_variant -%}
                    <p class="cart-item__meta">
                      {%- for option in item.options_with_values -%}
                        {{ option.name }}: {{ option.value }}{% unless forloop.last %} · {% endunless %}
                      {%- endfor -%}
                    </p>
                  {%- endunless -%}
                  {%- for property in item.properties -%}
                    {%- unless property.last == blank or property.first contains '_' -%}
                      <p class="cart-item__meta">{{ property.first }}: {{ property.last }}</p>
                    {%- endunless -%}
                  {%- endfor -%}
                  <div class="cart-item__controls">
                    <div class="quantity">
                      <button type="button" data-cart-qty="-1" aria-label="Decrease quantity of {{ item.product.title | escape }}">{% render 'icon', name: 'minus' %}</button>
                      <label class="visually-hidden" for="Qty-{{ item.key }}">Quantity of {{ item.product.title | escape }}</label>
                      <input id="Qty-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
                      <button type="button" data-cart-qty="1" aria-label="Increase quantity of {{ item.product.title | escape }}">{% render 'icon', name: 'plus' %}</button>
                    </div>
                    <a class="cart-item__remove" href="{{ item.url_to_remove }}">Remove<span class="visually-hidden"> {{ item.product.title }}</span></a>
                  </div>
                </div>
                <p class="cart-item__total">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <s class="price__compare">{{ item.original_line_price | money }}</s><br>
                  {%- endif -%}
                  {{ item.final_line_price | money }}
                </p>
              </li>
            {%- endfor -%}
          </ul>
          <p style="margin-top: 1rem;"><button type="submit" name="update" class="btn btn--ghost" data-js-hide>Update cart</button></p>
          <p style="margin-top: 1.5rem;"><a class="link-arrow" href="{{ routes.all_products_collection_url }}">Keep shopping {% render 'icon', name: 'arrow' %}</a></p>
        </div>

        <aside class="cart__summary" aria-labelledby="CartSummary">
          <h2 id="CartSummary">Your order</h2>
          <div class="cart__row"><span>Subtotal</span><span>{{ cart.items_subtotal_price | money }}</span></div>
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="cart__row"><span>{{ discount.title }}</span><span>-{{ discount.total_allocated_amount | money }}</span></div>
          {%- endfor -%}
          <div class="cart__row"><span>Shipping</span><span>Free</span></div>
          <div class="cart__row cart__row--total"><span>Total</span><span>{{ cart.total_price | money_with_currency }}</span></div>
          <p class="ship-note">{% render 'icon', name: 'truck' %}<span>Free shipping on every order<small>Taxes calculated at checkout.</small></span></p>
          {%- if section.settings.show_note -%}
            <div class="field cart__note">
              <label for="CartNote">Note for us (optional)</label>
              <textarea id="CartNote" name="note" placeholder="Gift message? Your dog's name? We love both.">{{ cart.note }}</textarea>
            </div>
          {%- endif -%}
          <button type="submit" name="checkout" class="btn btn--accent btn--full">Check out</button>
        </aside>
      </div>
    </form>
  {%- else -%}
    <div class="empty-state" data-reveal>
      {% render 'icon', name: 'bowl' %}
      <h2>Your cart is emptier than a licked bowl</h2>
      <p>Let's fix that. There's good stuff waiting for every mutt.</p>
      <a class="btn" href="{{ routes.all_products_collection_url }}">Shop All {% render 'icon', name: 'arrow' %}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "class": "section-main-cart",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your cart" },
    { "type": "checkbox", "id": "show_note", "label": "Show order note", "default": true }
  ]
}
{% endschema %}
