<div class="announcement">
  <div class="page-width announcement__inner">
    {% render 'icon', name: 'paw' %}
    <p>
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
      {%- else -%}
        {{ section.settings.text }}
      {%- endif -%}
    </p>
    {% render 'icon', name: 'paw' %}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Free shipping on every order."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    { "name": "Announcement bar" }
  ]
}
{% endschema %}
