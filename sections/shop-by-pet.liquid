<section class="section" aria-labelledby="PetTitle-{{ section.id }}">
  <div class="page-width">
    <div class="section-heading" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 id="PetTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
    </div>

    <div class="pet-cards">
      {%- for block in section.blocks -%}
        {%- liquid
          assign pet = block.settings.pet
          assign link = block.settings.collection.url | default: routes.collections_url
        -%}
        <a
          class="pet-card pet-card--{{ pet }}"
          href="{{ link }}"
          data-reveal
          style="--reveal-i: {{ forloop.index0 }};"
          {{ block.shopify_attributes }}
        >
          <span class="pet-card__blob" aria-hidden="true"></span>
          <div>
            <h3 class="pet-card__title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="pet-card__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
          <span class="pet-card__cta">
            {{ block.settings.cta }}
            {% render 'icon', name: 'arrow' %}
          </span>
          {%- if block.settings.image != blank -%}
            <span class="pet-card__image">
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 750px) 22vw, 45vw', alt: ''
              }}
            </span>
          {%- else -%}
            <span class="pet-card__art">
              {%- if pet == 'cats' -%}{% render 'illustration', name: 'cat' %}{%- else -%}{% render 'illustration', name: 'dog' %}{%- endif -%}
            </span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by pet",
  "class": "section-shop-by-pet",
  "max_blocks": 2,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Shop by pet" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Who are we shopping for today?" }
  ],
  "blocks": [
    {
      "type": "pet",
      "name": "Pet card",
      "settings": [
        {
          "type": "select",
          "id": "pet",
          "label": "Style",
          "options": [
            { "value": "dogs", "label": "Dogs (green)" },
            { "value": "cats", "label": "Cats (terracotta)" }
          ],
          "default": "dogs"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "For Dogs" },
        { "type": "text", "id": "text", "label": "Text", "default": "Shirts, bowls, beds and walk gear for the good boys, good girls and professional sock thieves." },
        { "type": "text", "id": "cta", "label": "Link label", "default": "Shop dog stuff" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo (optional)",
          "info": "Shown in a round frame. Leave empty to use the hand-drawn illustration."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by pet",
      "blocks": [
        { "type": "pet", "settings": { "pet": "dogs", "title": "For Dogs", "cta": "Shop dog stuff" } },
        {
          "type": "pet",
          "settings": {
            "pet": "cats",
            "title": "For Cats",
            "text": "Cozy spots, tidy bowls and grooming bits for cats who will absolutely pretend not to care.",
            "cta": "Shop cat stuff"
          }
        }
      ]
    }
  ]
}
{% endschema %}
