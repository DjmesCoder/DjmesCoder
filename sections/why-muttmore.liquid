<section class="why" aria-labelledby="WhyTitle-{{ section.id }}">
  <div class="doodle">{% render 'illustration', name: 'bone' %}</div>
  <div class="page-width">
    <div class="section-heading" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 id="WhyTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
    </div>

    <ul class="why__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="why__item" data-reveal style="--reveal-i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <span class="why__icon">{% render 'icon', name: block.settings.icon %}</span>
          <h3 class="h3">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p>{{ block.settings.text }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Why Muttmore",
  "class": "section-why",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Why Muttmore" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shopping here should feel easy. Like a good nap." }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "mail-heart", "label": "Mail" },
            { "value": "heart", "label": "Heart" },
            { "value": "paw", "label": "Paw" },
            { "value": "star", "label": "Star" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping on every order" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Muttmore",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "icon": "truck",
            "title": "Free shipping on every order",
            "text": "No minimums. No math. Just the good stuff, on its way to your door."
          }
        },
        {
          "type": "point",
          "settings": {
            "icon": "return",
            "title": "30-day returns on unopened items",
            "text": "Changed your mind? Send it back unopened within 30 days. No hard feelings."
          }
        },
        {
          "type": "point",
          "settings": {
            "icon": "mail-heart",
            "title": "Real people answering your emails",
            "text": "No bots, no ticket numbers. Just pet people who actually read what you wrote."
          }
        }
      ]
    }
  ]
}
{% endschema %}
