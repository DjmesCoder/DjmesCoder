{% layout 'password' %}
<div class="page-width page-width--form" style="padding-block: clamp(3rem, 10vw, 7rem);">
  <div class="empty-state">
    <span class="logo" style="justify-content: center;">
      <span class="logo__mark">{% render 'icon', name: 'paw' %}</span>
      <span>{{ shop.name }}</span>
    </span>
    <p class="hand-note">We're getting the shop ready.</p>
    <h1 class="h2">Good stuff for every mutt, coming soon</h1>
    {%- if shop.password_message != blank -%}
      <p>{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{% render 'icon', name: 'check' %}<span>You're on the list. We'll let you know when we open.</span></p>
      {%- else -%}
        <label class="visually-hidden" for="PasswordNotify">Email</label>
        <div class="search-form">
          <input class="input" id="PasswordNotify" type="email" name="contact[email]" autocomplete="email" placeholder="you@example.com" required>
          <button class="btn" type="submit">Notify me</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details style="margin-top: 1rem;">
      <summary style="cursor: pointer; font-weight: 700;">{{ 'general.password_page.login_form_heading' | t }}</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="search-form" style="margin-top: 1rem;">
          <label class="visually-hidden" for="StorePassword">{{ 'general.password_page.login_form_password_label' | t }}</label>
          <input class="input" id="StorePassword" type="password" name="password" autocomplete="current-password">
          <button class="btn btn--ghost" type="submit">{{ 'general.password_page.login_password_button' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</div>
