{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Your {{ gift_card.initial_value | money }} gift card · {{ shop.name }}</title>
    {{ 'fraunces-normal-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'nunito-sans-normal-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {% render 'fonts' %}
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body>
    <main class="page-width page-width--form" style="padding-block: 3rem;">
      <div class="empty-state">
        <span class="logo" style="justify-content: center;">
          <span class="logo__mark">{% render 'icon', name: 'paw' %}</span>
          <span>{{ shop.name }}</span>
        </span>
        <p class="hand-note">A little something for a good mutt</p>
        <h1 class="h2">{{ gift_card.initial_value | money }} gift card</h1>
        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p>This gift card is no longer active.</p>
        {%- else -%}
          <p>Balance: <strong>{{ gift_card.balance | money }}</strong></p>
          {%- if gift_card.expires_on -%}<p>Expires {{ gift_card.expires_on | date: '%B %-d, %Y' }}</p>{%- endif -%}
        {%- endif -%}
        <p style="font-size: 1.5rem; font-weight: 800; letter-spacing: .08em;">{{ gift_card.code | format_code }}</p>
        <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}" style="display: grid; place-items: center;"></div>
        <a class="btn" href="{{ shop.url }}">Start shopping</a>
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Add to Apple Wallet" loading="lazy"></a>
        {%- endif -%}
      </div>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
