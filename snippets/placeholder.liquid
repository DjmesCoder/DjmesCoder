{%- comment -%}
  Warm image placeholder shown until a real photo is uploaded.
  Params: label (string), art ('placeholder-dog' | 'placeholder-cat'), tint (css color)
{%- endcomment -%}
<div class="placeholder"{% if tint %} style="--placeholder-bg: {{ tint }};"{% endif %}>
  {%- assign art_name = art | default: 'placeholder-dog' -%}
  {% render 'illustration', name: art_name %}
  {%- if label != blank -%}
    <span class="placeholder__label">{{ label }}</span>
  {%- endif -%}
</div>
